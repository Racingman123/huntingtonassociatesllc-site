# Zero-service local demo. Copy this file to .env before running the app.
DATABASE_URL="file:./dev.db"
# development | staging | production. A production-built staging runtime may
# accept Stripe test-mode webhooks; the default is fail-safe production when
# NODE_ENV=production and this is omitted.
DEPLOYMENT_ENV="development"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional independent HMAC key for anonymous abuse-control identifiers.
# If empty, SESSION_SECRET is used.
RATE_LIMIT_SECRET=""
APP_URL="http://localhost:3000"
DEMO_MODE="true"
DEFAULT_TENANT_SLUG="northstar"
# tenant:bootstrap reads these only from the process environment. Do not store
# real bootstrap credentials in this file or in a tenant JSON manifest. Each
# value must be a distinct, non-placeholder password with at least 14 characters,
# uppercase, lowercase, number, and symbol, and at most 72 UTF-8 bytes. Remove
# both after bootstrap.
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_COMPLIANCE_PASSWORD=""
# Set true only behind a proxy that strips client-supplied forwarding headers.
TRUST_PROXY_HEADERS="false"
CRON_SECRET="replace-with-an-independent-32-character-secret"

# Optional production adapters. One-time Stripe checkout requires DEMO_MODE="false",
# both secrets, and a webhook endpoint subscribed to checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, invoice.paid, invoice_payment.paid, invoice.payment_failed,
# customer.subscription.updated/deleted, and refund.created/refund.updated/refund.failed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Keep this equal to the installed Stripe SDK's Stripe.API_VERSION.
STRIPE_WEBHOOK_API_VERSION="2026-06-24.dahlia"
# false accepts Stripe test-mode events; true accepts live-mode events.
STRIPE_WEBHOOK_LIVEMODE="false"
# Optional local-seed shortcut only. Production imports must write the active
# recurring Stripe Price to SubscriptionPlan.providerPriceId directly.
STRIPE_MEMBERSHIP_PRICE_ID=""
# Setting both to non-placeholder values enables the bounded email batch in maintenance.
EMAIL_FROM="Northstar Supply <hello@example.com>"
RESEND_API_KEY=""
