{
  "name": "giveaway-site-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:railway-demo": "prisma db push && NODE_ENV=development tsx prisma/seed.ts && npm run db:harden && next start -H 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node tests/integration/run-disposable.mjs",
    "test:e2e": "node tests/e2e/run-disposable.mjs",
    "test:e2e:direct": "playwright test",
    "theme:validate": "tsx scripts/theme.ts validate",
    "theme:publish": "tsx scripts/theme.ts publish",
    "brand:validate": "tsx scripts/brand.ts validate",
    "brand:plan": "tsx scripts/brand.ts plan",
    "brand:apply": "tsx scripts/brand.ts apply",
    "catalog:validate": "tsx scripts/catalog.ts validate",
    "catalog:plan": "tsx scripts/catalog.ts plan",
    "catalog:apply": "tsx scripts/catalog.ts apply",
    "campaign:validate": "tsx scripts/campaign.ts validate",
    "campaign:plan": "tsx scripts/campaign.ts plan",
    "campaign:publish": "tsx scripts/campaign.ts publish",
    "legal:validate": "tsx scripts/legal.ts validate",
    "legal:plan": "tsx scripts/legal.ts plan",
    "legal:publish": "tsx scripts/legal.ts publish",
    "tenant:validate": "tsx scripts/tenant.ts validate",
    "tenant:plan": "tsx scripts/tenant.ts plan",
    "tenant:bootstrap": "tsx scripts/tenant.ts bootstrap",
    "staff:list": "tsx scripts/staff.ts list",
    "validate:examples": "npm run theme:validate -- config/theme.example.json && npm run brand:validate -- config/brand.example.json && npm run tenant:validate -- config/tenant.example.json && npm run catalog:validate -- config/catalog.example.json && npm run legal:validate -- config/legal.example.json && npm run campaign:validate -- config/campaign.example.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:harden": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/sqlite-hardening.sql",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed && npm run db:harden",
    "db:reset": "prisma db push --force-reset && npm run db:seed && npm run db:harden",
    "verify": "npm run lint && npm run typecheck && npm run validate:examples && npm run test && npm run test:integration && npm run build",
    "verify:full": "npm run verify && npm run test:e2e && npm audit --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.17"
  }
}
