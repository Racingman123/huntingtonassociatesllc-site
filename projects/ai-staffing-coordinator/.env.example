# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Passwordless, single-tenant portfolio demo. This requires COMMUNICATION_PROVIDER=mock.
PUBLIC_DEMO_MODE=false

# PostgreSQL
DATABASE_URL=postgresql://staffing:staffing@localhost:5432/staffing
DATABASE_SSL=false

# Authentication — replace with at least 32 random bytes in production
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Company and policy
COMPANY_DISPLAY_NAME=Acme Staffing
DEFAULT_TIMEZONE=America/New_York
AGENT_DISCLOSURE=This is an automated scheduling assistant calling on behalf of your staffing company.
CONTACT_WINDOW_START_LOCAL=8
CONTACT_WINDOW_END_LOCAL=20
MAX_CALL_ATTEMPTS=2
MAX_CONCURRENT_OUTBOUND_CALLS=5
TRANSCRIPT_RETENTION_DAYS=90

# Background automation
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=15000
REMINDER_OFFSETS_MINUTES=1440,120

# Use mock for local/public demonstrations; use twilio only for authenticated production deployments
COMMUNICATION_PROVIDER=mock

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Twilio Voice and Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_WEBHOOKS=false
